# Copy to deploy/.env.production on the VPS. Never commit the copied file.
APP_ENV=production
DOMAIN=exam.example.edu
PUBLIC_BASE_URL=https://exam.example.edu

POSTGRES_DB=hnu_test
POSTGRES_USER=hnu
# Use an URL-safe password or URL-encode it inside DATABASE_URL.
POSTGRES_PASSWORD=CHANGE_ME_WITH_openssl_rand_hex_32
DATABASE_URL=postgres://hnu:CHANGE_ME_WITH_openssl_rand_hex_32@postgres:5432/hnu_test?sslmode=disable

# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_WITH_openssl_rand_hex_32
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
